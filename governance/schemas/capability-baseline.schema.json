{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jiezhengj.github.io/Spec-Kit-Reference/governance/schemas/capability-baseline.schema.json",
  "title": "Spec Kit governance capability baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline_id",
    "captured_at",
    "source_snapshots",
    "capabilities",
    "runtime_inventory"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "baseline_id": { "type": "string", "pattern": "^BASELINE-[A-Z0-9][A-Z0-9-]*$" },
    "captured_at": { "type": "string", "format": "date-time" },
    "source_snapshots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "capabilities": {
      "type": "array",
      "minItems": 31,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    },
    "runtime_inventory": { "$ref": "#/$defs/runtimeInventory" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "projectRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "section", "source_sha256"],
      "properties": {
        "file": { "$ref": "#/$defs/projectRelativePath" },
        "section": { "type": "string", "minLength": 1 },
        "source_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_by", "approved_at", "evidence"],
      "properties": {
        "approved_by": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "format": "date-time" },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "requirement", "disposition", "targets", "tests", "approval"],
      "properties": {
        "id": { "type": "string", "pattern": "^CAP-[A-Z0-9][A-Z0-9-]*$" },
        "source": { "$ref": "#/$defs/source" },
        "requirement": { "type": "string", "minLength": 1 },
        "disposition": { "enum": ["PRESERVE", "MOVE", "REPLACE"] },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/projectRelativePath" }
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^test_[a-z0-9_]+$" }
        },
        "approval": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/approval" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "disposition": { "const": "REPLACE" } } },
          "then": {
            "properties": { "approval": { "$ref": "#/$defs/approval" } }
          }
        },
        {
          "if": { "properties": { "disposition": { "enum": ["PRESERVE", "MOVE"] } } },
          "then": {
            "properties": { "approval": { "type": "null" } }
          }
        }
      ]
    },
    "runtimeInventoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["present", "absent", "unknown"] },
        "evidence": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtimeInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integrations",
        "default_integration",
        "extensions",
        "presets",
        "workflows",
        "events",
        "shared_infrastructure",
        "constitution",
        "specs",
        "agent_skills_or_commands",
        "project_governance_entrypoints"
      ],
      "properties": {
        "integrations": { "type": "array", "items": { "$ref": "#/$defs/runtimeInventoryItem" } },
        "default_integration": { "type": "array", "items": { "$ref": "#/$defs/runtimeInventoryItem" } },
        "extensions": { "type": "array", "items": { "$ref": "#/$defs/runtimeInventoryItem" } },
        "presets": { "type": "array", "items": { "$ref": "#/$defs/runtimeInventoryItem" } },
        "workflows": { "type": "array", "items": { "$ref": "#/$defs/runtimeInventoryItem" } },
        "events": { "type": "array", "items": { "$ref": "#/$defs/runtimeInventoryItem" } },
        "shared_infrastructure": { "type": "array", "items": { "$ref": "#/$defs/runtimeInventoryItem" } },
        "constitution": { "type": "array", "items": { "$ref": "#/$defs/runtimeInventoryItem" } },
        "specs": { "type": "array", "items": { "$ref": "#/$defs/runtimeInventoryItem" } },
        "agent_skills_or_commands": { "type": "array", "items": { "$ref": "#/$defs/runtimeInventoryItem" } },
        "project_governance_entrypoints": { "type": "array", "items": { "$ref": "#/$defs/runtimeInventoryItem" } }
      }
    }
  }
}
