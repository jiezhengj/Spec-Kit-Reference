{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jiezhengj.github.io/Spec-Kit-Reference/governance/schemas/task-readiness-report.schema.json",
  "title": "Tiny-model task package readiness report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature_id",
    "generated_at",
    "artifact_paths",
    "content_sha256",
    "result",
    "tasks"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "feature_id": { "$ref": "#/$defs/featureId" },
    "generated_at": { "type": "string", "format": "date-time" },
    "artifact_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/projectRelativePath" }
    },
    "content_sha256": { "$ref": "#/$defs/contentHashes" },
    "result": { "enum": ["READY", "BLOCKED"] },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    }
  },
  "$defs": {
    "featureId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "projectRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!\\.\\.?$).+$"
    },
    "contentHashes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/projectRelativePath" },
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "pathList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/projectRelativePath" }
    },
    "preconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency_task_ids"],
      "properties": {
        "dependency_task_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^T[0-9]+$" }
        }
      }
    },
    "contractText": {
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "$ref": "#/$defs/nonEmptyStrings" }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command", "expected_result"],
      "properties": {
        "kind": { "enum": ["command", "manual"] },
        "command": { "type": "string", "minLength": 1 },
        "expected_result": { "type": "string", "minLength": 1 }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "objective",
        "traceability",
        "context_summary",
        "preconditions",
        "allowed_files",
        "read_only_references",
        "forbidden_changes",
        "inputs_outputs",
        "invariants_and_edge_cases",
        "implementation_steps",
        "verification",
        "completion_evidence",
        "stop_conditions",
        "handoff"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^T[0-9]+$" },
        "objective": { "type": "string", "minLength": 1 },
        "traceability": { "$ref": "#/$defs/nonEmptyStrings" },
        "context_summary": { "type": "string", "minLength": 1 },
        "preconditions": { "$ref": "#/$defs/preconditions" },
        "allowed_files": {
          "allOf": [
            { "$ref": "#/$defs/pathList" },
            { "minItems": 1 }
          ]
        },
        "read_only_references": { "$ref": "#/$defs/pathList" },
        "forbidden_changes": { "$ref": "#/$defs/nonEmptyStrings" },
        "inputs_outputs": { "$ref": "#/$defs/contractText" },
        "invariants_and_edge_cases": { "$ref": "#/$defs/contractText" },
        "implementation_steps": { "$ref": "#/$defs/nonEmptyStrings" },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/verification" }
        },
        "completion_evidence": { "$ref": "#/$defs/contractText" },
        "stop_conditions": { "$ref": "#/$defs/contractText" },
        "handoff": { "type": "string", "minLength": 1 }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message", "task_id", "path"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "severity": { "enum": ["ERROR", "WARNING"] },
        "message": { "type": "string", "minLength": 1 },
        "task_id": { "type": ["string", "null"], "minLength": 1 },
        "path": {
          "anyOf": [
            { "$ref": "#/$defs/projectRelativePath" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
