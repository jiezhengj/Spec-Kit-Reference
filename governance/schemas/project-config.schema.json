{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jiezhengj.github.io/Spec-Kit-Reference/governance/schemas/project-config.schema.json",
  "title": "Spec Kit project governance configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "default_integration",
    "onboarding",
    "generic",
    "catalogs",
    "context",
    "documentation",
    "upgrade",
    "quality_gates",
    "workflow_governance"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "default_integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "key", "allow_change"],
      "properties": {
        "policy": { "const": "pinned" },
        "key": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "allow_change": { "type": "boolean" }
      }
    },
    "onboarding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_current_user_approval", "allow_unsafe_multi_install"],
      "properties": {
        "requires_current_user_approval": { "const": true },
        "allow_unsafe_multi_install": { "const": false }
      }
    },
    "generic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "maximum_bindings"],
      "properties": {
        "policy": { "enum": ["deny", "explicit-approval-required"] },
        "maximum_bindings": { "const": 1 }
      }
    },
    "catalogs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_sources"],
      "properties": {
        "allowed_sources": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_delivery_mode", "allow_materialized_after_loader_failure"],
      "properties": {
        "default_delivery_mode": { "const": "loader" },
        "allow_materialized_after_loader_failure": { "const": true }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language_tag", "selection_source", "scope"],
      "properties": {
        "language_tag": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
        },
        "selection_source": {
          "type": ["string", "null"],
          "enum": [null, "explicit-user-selection"]
        },
        "scope": { "const": "new-and-substantively-rewritten-project-documentation" }
      }
    },
    "upgrade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_mode"],
      "properties": {
        "review_mode": { "const": "pull-request-required" }
      }
    },
    "quality_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clarify", "checklist", "analyze", "validate", "converge"],
      "properties": {
        "clarify": { "const": "required" },
        "checklist": { "const": "required" },
        "analyze": { "const": "required" },
        "validate": { "const": "required" },
        "converge": { "const": "required" }
      }
    },
    "workflow_governance": { "$ref": "#/$defs/workflowGovernance" }
  },
  "$defs": {
    "workflowGovernance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "discovery",
        "artifact_reviews",
        "approval_evidence",
        "tiny_model_tasks",
        "cold_start_review"
      ],
      "properties": {
        "mode": { "const": "governed-sdd-required" },
        "discovery": { "const": "required-for-substantive" },
        "artifact_reviews": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "allOf": [
            { "contains": { "const": "DISCOVERY" }, "minContains": 1 },
            { "contains": { "const": "SPECIFICATION" }, "minContains": 1 },
            { "contains": { "const": "PLAN_BUNDLE" }, "minContains": 1 },
            { "contains": { "const": "TASK_PACKAGE" }, "minContains": 1 },
            { "contains": { "const": "REMEDIATION" }, "minContains": 1 }
          ],
          "items": {
            "enum": ["DISCOVERY", "SPECIFICATION", "PLAN_BUNDLE", "TASK_PACKAGE", "REMEDIATION"]
          }
        },
        "approval_evidence": { "const": "committed-project-local" },
        "tiny_model_tasks": { "const": "required" },
        "cold_start_review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "minimum_samples"],
          "properties": {
            "required": { "const": true },
            "minimum_samples": { "type": "integer", "minimum": 3 }
          }
        }
      }
    }
  }
}
