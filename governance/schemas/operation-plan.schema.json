{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jiezhengj.github.io/Spec-Kit-Reference/governance/schemas/operation-plan.schema.json",
  "title": "Spec Kit governance operation plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "plan_id", "operation_type", "created_at", "expires_at", "project_root_fingerprint",
    "git_head", "git_status_porcelain_sha256", "manifest_sha256", "project_config_sha256", "adapters_sha256",
    "local_overrides_sha256", "integration_status_sha256", "specify_version", "input_files", "current_agent",
    "claimed_integration_key", "required_native_key", "native_fallback_prohibited", "native_target_paths",
    "write_preflight", "on_native_write_failure", "context_anchor", "anchor_compatibility_evidence",
    "manager_file_mutations", "external_cli_mutations", "capability_inventory_before", "default_integration_change", "network_required",
    "required_user_authorization", "risk_assessment", "recovery_steps", "plan_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "plan_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "operation_type": { "enum": ["init", "onboard", "default-change", "upgrade", "rollback", "plan-governance-bootstrap", "plan-install-update-reminder", "plan-init", "plan-onboard", "plan-extension-install", "plan-default-change", "plan-upgrade", "plan-rollback", "plan-activate-binding"] },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "project_root_fingerprint": { "$ref": "#/$defs/sha256" },
    "git_head": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|UNBORN)$" },
    "git_status_porcelain_sha256": { "$ref": "#/$defs/sha256" },
    "manifest_sha256": { "$ref": "#/$defs/nullableSha256" },
    "project_config_sha256": { "$ref": "#/$defs/nullableSha256" },
    "adapters_sha256": { "$ref": "#/$defs/nullableSha256" },
    "local_overrides_sha256": { "$ref": "#/$defs/nullableSha256" },
    "integration_status_sha256": { "$ref": "#/$defs/nullableSha256" },
    "specify_version": { "anyOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
    "input_files": { "type": "array", "items": { "$ref": "#/$defs/inputFile" } },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/inputFile" } },
    "current_agent": { "$ref": "#/$defs/currentAgent" },
    "identity": { "type": "object" },
    "claimed_integration_key": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }] },
    "required_native_key": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "native_fallback_prohibited": { "type": "boolean" },
    "native_target_paths": { "type": "array", "items": { "$ref": "#/$defs/projectRelativePath" } },
    "write_preflight": { "type": "array", "items": { "$ref": "#/$defs/writePreflight" } },
    "on_native_write_failure": { "const": "NATIVE_INSTALL_BLOCKED" },
    "context_anchor": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/projectRelativePath" }] },
    "anchor": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/projectRelativePath" }] },
    "anchor_compatibility_evidence": { "type": "array", "items": { "$ref": "#/$defs/anchorEvidence" } },
    "documentation_language": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "capability_inventory_before": { "type": "object" },
    "rehearsal": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/rehearsal" }] },
    "manager_file_mutations": { "type": "array", "items": { "$ref": "#/$defs/managerMutation" } },
    "external_cli_mutations": { "type": "array", "items": { "$ref": "#/$defs/externalMutation" } },
    "default_integration_change": { "type": "boolean" },
    "changes_default_integration": { "type": "boolean" },
    "network_required": { "type": "boolean" },
    "requires_network": { "type": "boolean" },
    "required_user_authorization": { "type": "string", "minLength": 1 },
    "risk_assessment": { "$ref": "#/$defs/riskAssessment" },
    "recovery_steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "risks_and_recovery": { "type": "array", "items": { "type": "string" } },
    "previous_default_integration": { "type": ["string", "null"] },
    "plan_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableSha256": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
    "projectRelativePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "inputFile": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "$ref": "#/$defs/projectRelativePath" }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "currentAgent": { "type": "object", "additionalProperties": false, "required": ["runtime_id", "declaration_source"], "properties": { "runtime_id": { "type": "string", "minLength": 1 }, "declaration_source": { "enum": ["user-declared", "host-metadata", "environment", "runtime-declared"] } } },
    "writePreflight": { "type": "object", "additionalProperties": false, "required": ["path", "writable", "evidence"], "properties": { "path": { "$ref": "#/$defs/projectRelativePath" }, "writable": { "type": "boolean" }, "evidence": { "type": "string", "minLength": 1 } } },
    "anchorEvidence": { "type": "object", "additionalProperties": false, "required": ["source", "content_sha256", "review_conclusion"], "properties": { "source": { "type": "string", "minLength": 1 }, "content_sha256": { "$ref": "#/$defs/sha256" }, "review_conclusion": { "type": "string", "minLength": 1 } } },
    "managerMutation": { "type": "object", "additionalProperties": false, "required": ["action", "path", "old_sha256", "expected_new_sha256", "mode", "content_b64"], "properties": { "action": { "enum": ["create", "replace", "delete", "append-managed-loader", "append-managed-update-reminder"] }, "path": { "$ref": "#/$defs/projectRelativePath" }, "old_sha256": { "$ref": "#/$defs/nullableSha256" }, "expected_new_sha256": { "$ref": "#/$defs/nullableSha256" }, "new_sha256": { "$ref": "#/$defs/nullableSha256" }, "mode": { "anyOf": [{ "type": "integer" }, { "type": "string", "pattern": "^[0-7]{3,4}$" }] }, "rollback_bytes_reference": { "type": "string" }, "content_b64": { "type": "string", "minLength": 1 }, "protected_anchor": { "const": true } } },
    "externalMutation": { "type": "object", "additionalProperties": false, "required": ["argv", "allowed_path_prefixes"], "properties": { "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "cwd": { "type": "string" }, "working_directory": { "$ref": "#/$defs/projectRelativePath" }, "cli_version": { "type": "string" }, "allowed_path_prefixes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/projectRelativePath" } }, "pre_apply_snapshot": { "type": "array" }, "pre_execution_snapshot": { "type": "array", "items": { "$ref": "#/$defs/inputFile" } }, "postconditions": { "type": "array" }, "expected_status_postconditions": { "type": "array", "items": { "type": "string" } }, "expected_managed_file_postconditions": { "type": "array", "items": { "type": "string" } }, "changed_file_inventory": { "type": "string" }, "changed_file_inventory_path": { "$ref": "#/$defs/projectRelativePath" }, "failure_recovery_protocol": { "type": "string" }, "rollback_argv": { "type": "array", "items": { "type": "string" } } } },
    "riskAssessment": { "type": "object", "additionalProperties": false, "required": ["ambiguity_open", "cross_cutting_component_count", "public_contract_change", "data_migration", "security_impact", "compliance_impact", "irreversible_operation", "artifact_conflict", "unknown_bug_cause", "evidence"], "properties": { "ambiguity_open": { "type": "boolean" }, "cross_cutting_component_count": { "type": "integer", "minimum": 0 }, "public_contract_change": { "type": "boolean" }, "data_migration": { "type": "boolean" }, "security_impact": { "type": "boolean" }, "compliance_impact": { "type": "boolean" }, "irreversible_operation": { "type": "boolean" }, "artifact_conflict": { "type": "boolean" }, "unknown_bug_cause": { "type": "boolean" }, "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/projectRelativePath" } } } },
    "rehearsal": { "type": "object", "additionalProperties": false, "required": ["argv", "cli_version", "force", "changed_files", "changed_sha256", "allowed_path_prefixes", "stdout_sha256", "stderr_sha256"], "properties": { "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "cli_version": { "type": ["string", "null"] }, "force": { "type": "boolean" }, "changed_files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/projectRelativePath" } }, "changed_sha256": { "type": "object", "additionalProperties": { "$ref": "#/$defs/sha256" } }, "allowed_path_prefixes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/projectRelativePath" } }, "stdout_sha256": { "$ref": "#/$defs/sha256" }, "stderr_sha256": { "$ref": "#/$defs/sha256" } } }
  },
  "allOf": [
    {
      "if": { "properties": { "operation_type": { "const": "plan-install-update-reminder" } } },
      "then": {
        "required": ["context_anchor"],
        "properties": {
          "context_anchor": { "$ref": "#/$defs/projectRelativePath" }
        }
      }
    },
    {
      "if": { "properties": { "operation_type": { "const": "plan-init" } } },
      "then": {
        "required": ["documentation_language", "context_anchor"],
        "properties": {
          "documentation_language": { "type": "string", "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$" },
          "context_anchor": { "$ref": "#/$defs/projectRelativePath" }
        }
      }
    },
    {
      "if": { "properties": { "operation_type": { "const": "plan-onboard" } } },
      "then": { "properties": { "native_fallback_prohibited": { "const": true } } }
    }
  ]
}
