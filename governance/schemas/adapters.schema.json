{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jiezhengj.github.io/Spec-Kit-Reference/governance/schemas/adapters.schema.json",
  "title": "Spec Kit project adapter registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "anchors", "bindings"],
  "properties": {
    "schema_version": { "const": 1 },
    "anchors": {
      "type": "array",
      "items": { "$ref": "#/$defs/anchor" }
    },
    "bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/binding" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "projectRelativePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "format", "delivery_mode", "marker_start", "marker_end", "managed_content_sha256", "status", "managed"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "path": { "$ref": "#/$defs/projectRelativePath" },
        "format": { "enum": ["markdown", "text"] },
        "delivery_mode": { "enum": ["loader", "materialized"] },
        "marker_start": { "type": "string", "minLength": 1 },
        "marker_end": { "type": "string", "minLength": 1 },
        "managed_content_sha256": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["rendered", "stale", "blocked"] },
        "managed": { "const": true }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_workflow", "extensions", "presets", "events"],
      "properties": {
        "core_workflow": { "$ref": "#/$defs/capabilityStatus" },
        "extensions": { "$ref": "#/$defs/capabilityStatus" },
        "presets": { "$ref": "#/$defs/capabilityStatus" },
        "events": { "$ref": "#/$defs/capabilityStatus" }
      }
    },
    "capabilityStatus": { "enum": ["verified", "not-verified", "not-applicable", "blocked"] },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "specify_version", "product_version", "verified_at", "method", "evidence"],
      "properties": {
        "status": { "enum": ["provisional", "active", "deprecated", "blocked"] },
        "specify_version": { "type": "string", "minLength": 1 },
        "product_version": { "type": "string", "minLength": 1 },
        "verified_at": { "type": "string", "format": "date-time" },
        "method": { "enum": ["fresh-session-loader", "fresh-session-materialized"] },
        "evidence": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_id", "display_name", "integration_key", "integration_mode", "status_evidence_sha256", "default_integration_changed", "anchor_ids", "capabilities", "verification"],
      "properties": {
        "runtime_id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "integration_key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "integration_mode": { "enum": ["native", "explicit-generic-transition"] },
        "status_evidence_sha256": { "$ref": "#/$defs/sha256" },
        "default_integration_changed": { "type": "boolean" },
        "anchor_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "verification": { "$ref": "#/$defs/verification" },
        "generic_transition": { "$ref": "#/$defs/genericTransition" }
      }
    },
    "genericTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native_absence_attestation_sha256", "native_absence_evidence", "attested_specify_version", "native_integration_available_at_approval", "limitations_acknowledged", "commands_dir", "format", "compatibility_verified"],
      "properties": {
        "native_absence_attestation_sha256": { "$ref": "#/$defs/sha256" },
        "native_absence_evidence": { "$ref": "#/$defs/projectRelativePath" },
        "attested_specify_version": { "type": "string", "minLength": 1 },
        "native_integration_available_at_approval": { "const": false },
        "limitations_acknowledged": { "const": true },
        "commands_dir": { "$ref": "#/$defs/projectRelativePath" },
        "format": { "const": "markdown" },
        "compatibility_verified": { "const": true }
      }
    }
  }
}
