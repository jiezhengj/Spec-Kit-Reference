    { "id": "CAP-CHECKER-VALIDATES-OFFICIAL-REMOTE", "source": { "file": "scripts/check_upstream.py", "section": "main", "source_sha256": "ed067d7aebd23b2ee654efe74002455afb7af4ee386f689e9f0ebf04c7fc7e26" }, "requirement": "Reject an upstream remote that is not one of the official github/spec-kit URLs.", "disposition": "PRESERVE", "targets": ["scripts/check_upstream.py"], "tests": ["test_checker_rejects_nonofficial_upstream_remote"], "approval": null },
